# Normalisasi akhir baris: simpan LF di repo agar build konsisten lintas OS.
* text=auto eol=lf

# Script Windows tetap CRLF supaya bisa dijalankan langsung.
*.bat text eol=crlf
*.cmd text eol=crlf

# File biner tidak boleh dinormalisasi.
*.apk binary
*.aab binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary
